# Copy this file to .env and fill in real values.
# Local dev without Postgres installed: just leave DATABASE_URL unset/commented out
# and the app will fall back to a local SQLite file automatically.

# Example for local Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/factorypulse

# Example for a deployed Postgres (e.g. Railway/Render) — copy the connection
# string they give you exactly as provided:
# DATABASE_URL=postgresql://user:password@host:port/dbname
